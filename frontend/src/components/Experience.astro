---
import ExperienceList, { type ExperienceItem } from "./solid/ExperienceList";

const fallbackExperience = [
  {
    company: "VLED — NPTEL VINTERNSHIP",
    role: "MERN_STACK_DEVELOPER_INTERN",
    period: "JAN_2026_MAR_2026",
    summary:
      "Contributed to open-source internship platforms, patched security vulnerabilities, and built RAG-powered AI tools for social impact.",
    stack: ["REACT", "NODE.JS", "MONGODB", "GEMINI_AI"],
  },
  {
    company: "GURUKULA_KANGRI_UNIVERSITY",
    role: "BTECH_STUDENT",
    period: "AUG_2024_PRESENT",
    summary:
      "Pursuing Computer Science and Engineering with a focus on DSA, DBMS, and Web Development; maintaining a GPA of 9.1.",
    stack: ["JAVA", "C++", "DSA", "SQL"],
  },
 ] satisfies ExperienceItem[];
---

<section id="experience" data-bg-layer="experience" class="min-h-[calc(100svh-4rem)] scroll-mt-16 snap-start border-b border-border bg-transparent py-8 md:py-10 flex items-center">
  <div class="max-w-7xl mx-auto w-full px-4 md:px-8">
    <div class="mb-8 md:mb-10 flex justify-between items-end gap-4">
      <div class="space-y-2">
        <h2 class="text-[10px] font-mono text-muted-foreground tracking-[0.2em] uppercase">// EXECUTION_HISTORY</h2>
        <h3 class="text-3xl font-mono font-bold tracking-tighter italic">SYSTEM_EXPERIENCE_LOG</h3>
      </div>
      <div class="hidden sm:block text-[10px] font-mono text-muted-foreground">
        STATUS: <span class="text-brand-green">RESUME_SYNC_ACTIVE</span>
      </div>
    </div>

    <div class="custom-scroll-host pr-4">
      <ExperienceList client:visible items={fallbackExperience} />
      <div class="custom-scrollbar custom-scrollbar-vertical" data-scrollbar-for="experience-list" data-scrollbar-orientation="vertical">
        <div class="custom-scrollbar-track">
          <div class="custom-scrollbar-thumb"></div>
        </div>
      </div>
    </div>
  </div>
</section>
