# Smart Portfolio Backend
# Copy to .env for local development or configure these in your host.

# Required
DATABASE_URL=postgres://portfolio:portfolio_secret@localhost:5432/smart_portfolio?sslmode=disable
GROQ_API_KEY=your-groq-api-key-here
JINA_API_KEY=your-jina-api-key-here

# Vector store
# The app defaults to Pinecone. Set VECTOR_STORE_PROVIDER=pgvector only if your
# database has pgvector support and the related tables/indexes are available.
VECTOR_STORE_PROVIDER=pinecone
PINECONE_API_KEY=
PINECONE_INDEX=smart-portfolio

# AI models
# These defaults are used automatically; override only when changing providers/models.
AI_MODEL=openai/gpt-oss-20b
EMBEDDING_MODEL=jina-embeddings-v2-base-en

# GitHub works sync
GITHUB_USERNAME=
GITHUB_API_TOKEN=

# Discord notifications
DISCORD_CONTACT_WEBHOOK_URL=
DISCORD_PAYMENT_WEBHOOK_URL=

# Razorpay sponsorship payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Resume redirect target used by GET /api/resume
RESUME_URL=https://your-resume-link

# Frontend origin for CORS
FRONTEND_URL=http://localhost:5173

# Admin endpoints
# Leave empty only for local development.
ADMIN_API_KEY=

# Optional operational defaults such as SERVER_PORT, DB pool sizes, cache TTL,
# rate limits, outbox polling, Pinecone region, and GitHub sync intervals are
# defined in internal/config/config.go and do not need to be present here.
